# Copy this file to `.env` on the server (NOT in git) and fill in real
# values. See config/mail.php for how these are read, and
# docs/migration-requirements.md #19 for why mail() alone isn't enough.
#
# andrew@cleangreenturf.com is a Google Workspace address, so this sends
# via Gmail's SMTP relay using that same mailbox — leads land directly in
# the inbox you already check, sent from your own address.
#
# Setup (one-time, takes ~2 minutes):
#   1. While logged into andrew@cleangreenturf.com, go to
#      https://myaccount.google.com/security and turn on 2-Step
#      Verification if it isn't already on (required for step 2).
#   2. Go to https://myaccount.google.com/apppasswords, create a new app
#      password (name it something like "Clean Green Turf Website"), and
#      copy the 16-character password it generates.
#   3. Paste that as SMTP_PASSWORD below (remove any spaces Google shows
#      it with). This is NOT your normal Google login password — app
#      passwords are single-purpose and can be revoked independently.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=andrew@cleangreenturf.com
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=andrew@cleangreenturf.com
SMTP_FROM_NAME=Clean Green Turf Website

# ---------------------------------------------------------------------------
# Admin dashboard password (protects /admin/appointments.php — the list of
# turf-installation-estimate bookings). Pick any strong password; there's no
# username, just this one shared password. See config/mail.php's env() for
# how it's read.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Twilio (SMS) — used only for the day-before appointment-reminder text on
# /schedule-turf-installation-estimate bookings (see bin/send-reminders.php).
# Without these set, the scheduler still works fully (booking, email
# confirmations, rescheduling) — it just skips the reminder text until this
# is configured.
#
# Setup (~5 minutes, at https://console.twilio.com):
#   1. Sign up for Twilio (or use an existing account).
#   2. Buy/verify a phone number capable of sending SMS (a trial account can
#      send to your own verified number for free to test).
#   3. Copy the Account SID and Auth Token from the Console dashboard home
#      page, and the SMS-capable number you bought (in E.164 format, e.g.
#      +14695551234), into the three values below.
#   4. On Hostinger, set up an HOURLY cron job (hPanel > Advanced > Cron
#      Jobs) running `php bin/send-reminders.php` — see that file's header
#      comment for the exact command and why it needs to run hourly, not
#      once a day.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Zoho CRM — pushes new quote-form and turf-installation-scheduler leads
# into Zoho CRM's Deals module, into whichever pipeline (Turf Cleaning /
# Turf Installation / Turf Repair) matches the service requested. Without
# these set, the site works exactly as before — forms/handle-quote.php and
# scheduler/book.php just skip the CRM push (see includes/zoho-crm.php).
#
# Setup (~5 minutes, at https://api-console.zoho.com — sign in as
# andrew@cleangreenturf.com):
#   1. Click "Add Client" > "Self Client". This is the simplest option for
#      a server-to-server integration like this one — no redirect URL or
#      browser login flow needed, unlike "Server-based Applications".
#   2. In the Self Client screen, go to the "Generate Code" tab. For scope,
#      enter (all on one line, comma-separated, no spaces around commas):
#        ZohoCRM.modules.deals.ALL,ZohoCRM.modules.accounts.ALL,ZohoCRM.modules.contacts.ALL
#      (Deals alone isn't enough — creating a Deal also needs to look up
#      or create its linked Account and Contact records, confirmed by a
#      live MANDATORY_NOT_FOUND rejection when only deals.CREATE was
#      granted; see docs/audit-findings.md "Zoho CRM integration.")
#      Set duration to 10 minutes and add any description. Click Create,
#      then copy the "Code" it shows you — this expires fast, so do step 3
#      right away. If you already generated a code with just
#      ZohoCRM.modules.deals.CREATE, generate a new one with this wider
#      scope and redo steps 3-4 — the refresh token is tied to whatever
#      scope was granted when it was created.
#   3. Also on that same Self Client screen, note the Client ID and Client
#      Secret (under the "Client Secret" tab) — paste them into
#      ZOHO_CLIENT_ID / ZOHO_CLIENT_SECRET below.
#   4. Exchange the code for a refresh token — from any terminal (this can
#      be done from a personal computer, it doesn't need to run on the
#      server):
#        curl -X POST https://accounts.zoho.com/oauth/v2/token \
#          -d "grant_type=authorization_code" \
#          -d "client_id=YOUR_CLIENT_ID" \
#          -d "client_secret=YOUR_CLIENT_SECRET" \
#          -d "code=YOUR_CODE_FROM_STEP_2"
#      The response is JSON containing a "refresh_token" — copy that into
#      ZOHO_REFRESH_TOKEN below. This token doesn't expire, so this is a
#      one-time setup (unless it's ever revoked in Zoho's API Console).
#   5. If your Zoho account is on a data center other than the US
#      (zoho.com), e.g. zoho.eu or zoho.in, also set ZOHO_ACCOUNTS_DOMAIN
#      and ZOHO_API_DOMAIN to match (https://accounts.zoho.eu and
#      https://www.zohoapis.eu, for example) — leave them unset for zoho.com.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_DOMAIN=
ZOHO_API_DOMAIN=
