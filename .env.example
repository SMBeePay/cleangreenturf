# Copy this file to `.env` on the server (NOT in git) and fill in real
# values. See config/mail.php for how these are read, and
# docs/migration-requirements.md #19 for why mail() alone isn't enough.
#
# Get these from Hostinger hPanel > Emails (create a mailbox like
# no-reply@cleangreenturf.com, then use its SMTP credentials here) or from
# a transactional email provider if preferred.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@cleangreenturf.com
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=no-reply@cleangreenturf.com
SMTP_FROM_NAME=Clean Green Turf Website
