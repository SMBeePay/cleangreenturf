# Clean Green Turf — Apache config for the PHP front-controller architecture.
# See docs/migration-requirements.md for the full rationale.

RewriteEngine On

# 1) Canonical host: force non-www
RewriteCond %{HTTP_HOST} ^www\.cleangreenturf\.com$ [NC]
RewriteRule ^(.*)$ https://cleangreenturf.com/$1 [L,R=301]

# 2) Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://cleangreenturf.com/%{REQUEST_URI} [L,R=301]

# 3) Never serve source/content directories directly (defense in depth —
#    each also has its own "deny all" .htaccess)
RewriteRule ^(config|content|includes|templates|bin|docs|vendor)(/|$) - [F,L]

# 4) Real files/directories (assets, forms/*.php) pass through untouched
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5) Everything else goes through the front controller — this is what keeps
#    URLs extension-less (no .php in any public URL)
RewriteRule ^ index.php [L]

Options -Indexes
ErrorDocument 404 /index.php

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
